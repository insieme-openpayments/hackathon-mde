FROM node:24-slim

RUN apt-get update && \
    apt-get install -y python3 build-essential && \
    apt-get clean

WORKDIR /app

RUN corepack enable
RUN corepack prepare pnpm@9.1.4 --activate

COPY pnpm-lock.yaml .nvmrc .npmrc insieme-entrypoint.sh ./

RUN pnpm fetch

ADD . ./

RUN pnpm install --filter @insieme/backend... --offline

RUN pnpm insieme:backend build

EXPOSE ${DEBUG_PORT}

ARG DEV_MODE
ENV DEV_MODE=${DEV_MODE}

RUN chmod +x /app/insieme-entrypoint.sh

ENTRYPOINT ["/app/insieme-entrypoint.sh"]
