# Copy this file to .env.local and adjust values to run the backend locally.
# If you create both .env.local and .env, values in .env override values from .env.local.
# Do not commit sensitive real credentials.

########## INFRASTRUCTURE #######################################################################
PORT=3004
NODE_ENV=development
FRONTEND_URL=http://localhost:4004
DATABASE_URL=postgres://boutique_backend:boutique_backend@localhost:15434/boutique_backend

######### OPEN PAYMENTS CONFIGURATION to make Boutique work ######################################
## Create a wallet at https://wallet.interledger-test.dev, then create Developer Keys for it.
## The payment pointer must be prefixed with `https://` (not `$`).
# PAYMENT_POINTER=https://ilp.interledger-test.dev/your-wallet
# KEY_ID=guid-here
# PRIVATE_KEY=base64-encoded-private-key-here
