# Copia este archivo a deploy/.env (no se versiona) y completa los valores.

# Origen público del deploy (sin barra final). Open Payments redirige aquí al terminar el pago.
PUBLIC_URL=http://localhost:8080

# Open Payments (obligatorio): wallet en https://wallet.interledger-test.dev → Developer Keys.
# PAYMENT_POINTER con https:// (no $). PRIVATE_KEY = el .pem en base64, en una sola línea.
PAYMENT_POINTER=
KEY_ID=
PRIVATE_KEY=

# integration-backend (interno). dummy = catálogo simulado; puntored = PuntoRed preprod (pagos reales de prueba).
API_KEY=insieme-dev-key
CATALOG_SOURCE=dummy
# Con CATALOG_SOURCE=puntored, completa las variables PUNTORED_* (ver README de integration-backend).
# PUNTORED_USERNAME=
# PUNTORED_PASSWORD=
# PUNTORED_COMMERCE=
# PUNTORED_POINT_OF_SALE=
# PUNTORED_TERMINAL=
# PUNTORED_TRANSACTIONAL_PASSWORD=

# Frontend
THEME=dark
CURRENCY=COP

# Postgres externo (opcional). Si se define, no se usa el Postgres embebido.
# DATABASE_URL=postgres://usuario:clave@host:5432/insieme_backend
