{
  "name": "insieme",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone fork of the Interledger Testnet Boutique (packages/boutique) at commit 09dd1fb3cc77eff9e4b08f112be39a80f99d149d, flattened to backend/, frontend/ and shared/",
  "license": "Apache-2.0",
  "scripts": {
    "insieme:backend": "pnpm --filter @insieme/backend --",
    "insieme:frontend": "pnpm --filter @insieme/frontend --",
    "build": "pnpm -r build",
    "checks": "pnpm prettier:check && pnpm lint:check",
    "test": "pnpm insieme:backend test",
    "clean": "pnpm clean:modules && pnpm clean:builds",
    "clean:builds": "find . -name \"dist\" -type d -prune -exec rm -rf '{}' +",
    "clean:modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "dev": "pnpm local:up && concurrently -n \"INSIEME-BE,INSIEME-FE\" -c red.bold,red \"pnpm insieme:backend dev\" \"pnpm insieme:frontend dev\"",
    "format": "pnpm prettier:write && pnpm lint:fix",
    "lint": "pnpm lint:check",
    "lint:check": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --max-warnings=0 --fix .",
    "compose": "docker compose -f ./local/docker-compose.yml",
    "local:up": "pnpm compose up -d",
    "local:down": "pnpm compose down",
    "local:reset": "pnpm compose down -v",
    "local:logs": "pnpm compose logs -f",
    "compose:app": "docker compose -f ./local/docker-compose.app.yml",
    "docker:build": "pnpm compose:app build",
    "docker:up": "pnpm compose:app up -d --build",
    "docker:down": "pnpm compose:app down",
    "docker:logs": "pnpm compose:app logs -f",
    "preinstall": "npx only-allow pnpm",
    "prettier:write": "prettier --config \".prettierrc.js\" --write .",
    "prettier:check": "prettier --config \".prettierrc.js\" --check ."
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "only-allow": "^1.2.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "pnpm": "^9.1.4",
    "npm": "pnpm",
    "yarn": "pnpm",
    "node": ">=24"
  },
  "packageManager": "pnpm@9.1.4"
}
